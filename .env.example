# Public (browser) values. Copy to .env.local.
VITE_SITE_URL=                # final domain, e.g. https://example.com (enables canonical + sitemap)
VITE_CONTACT_ENDPOINT=/api/contact
VITE_NEWSLETTER_ENDPOINT=/api/subscribe
VITE_BOOKING_URL=             # Calendly / Cal.com link; hides "Book a call" if empty
VITE_WHATSAPP_URL=
VITE_INSTAGRAM_URL=           # optional override; defaults to instagram.com/petitefave
VITE_TIKTOK_URL=              # optional override; defaults to tiktok.com/@petitefave__ugc
VITE_LINKEDIN_URL=
VITE_CV_URL=                  # optional override; defaults to /Oluwaiye-Favour-Esther-CV-2026.pdf (file in /public)
VITE_ANALYTICS_DOMAIN=        # Plausible site domain; no tracking script loads if empty

# SERVER-ONLY secrets. Set in the host dashboard (Vercel), never with a VITE_ prefix.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=           # must be a sender verified in Resend
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=          # optional: group used to mark sign-ups from the site
VITE_MEDIA_BASE=            # where videos are hosted (e.g. https://cdn.example.com/media). Local dev uses /media
